#!/usr/bin/env bash
for ((i = 1; i < $#; i++)); do
	if [ "${!i}" = "--mode" ]; then
		next=$((i + 1))
		if [ "${!next}" = "rpc" ]; then
			printf '%s\n' '{"id":"pr-tour-tools","success":true,"data":{"dumpTools":[]}}'
			exit 0
		fi
	fi
done
[ -n "${OMP_CALLS:-}" ] && echo "$*" >>"$OMP_CALLS"
echo "model not found" >&2
exit 1
